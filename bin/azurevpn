#!/usr/bin/env python3
import sys
import os
import re
import json
import subprocess
import time
import shutil
import getpass
import tempfile
import hashlib
import platform
import xml.etree.ElementTree as ET
from pathlib import Path

OPENP2S_VERSION = "0.2.0"
OPENP2S_SHA256 = "dcdd4777c96c4e40594af1d9416e3f858d4045eadc2db7f2a550d216cecac7b6"

SELF_PATH = str(Path(__file__).resolve())
CONFIG_DIR = Path.home() / ".config" / "azure-vpn"
PROFILES_DIR = CONFIG_DIR / "profiles"
CONFIG_FILE = CONFIG_DIR / "config.json"
SYSTEMD_USER_DIR = Path.home() / ".config" / "systemd" / "user"
SERVICE_FILE = SYSTEMD_USER_DIR / "azure-vpn.service"

def ensure_systemd_service():
    SYSTEMD_USER_DIR.mkdir(parents=True, exist_ok=True)
    openp2s_bin = shutil.which("openp2s") or "/usr/local/bin/openp2s"
    service_content = f"""[Unit]
Description=Azure VPN Client Background Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=simple
ExecStart={SELF_PATH} daemon
ExecStop={openp2s_bin} disconnect
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
"""
    if not SERVICE_FILE.exists() or SERVICE_FILE.read_text(encoding="utf-8") != service_content:
        SERVICE_FILE.write_text(service_content, encoding="utf-8")
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True, check=False)

def ensure_dirs():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR.chmod(0o700)
    PROFILES_DIR.mkdir(parents=True, exist_ok=True)
    PROFILES_DIR.chmod(0o700)
    
    state_dir = Path.home() / ".local" / "state" / "openp2s"
    if state_dir.exists():
        try:
            state_dir.chmod(0o700)
        except Exception as e:
            sys.stderr.write(f"Warning: could not chmod state dir: {e}\n")

    if not CONFIG_FILE.exists():
        with open(CONFIG_FILE, "w") as f:
            json.dump({
                "active_profile": "",
                "dns_all": False,
                "allow_system_trust_store": True
            }, f, indent=2)
    CONFIG_FILE.chmod(0o600)

    for p in PROFILES_DIR.glob("*.xml"):
        try:
            p.chmod(0o600)
        except Exception:
            pass

def load_config():
    ensure_dirs()
    try:
        with open(CONFIG_FILE, "r") as f:
            cfg = json.load(f)
    except Exception:
        cfg = {}
    if not isinstance(cfg, dict):
        cfg = {}
    cfg.setdefault("active_profile", "")
    cfg.setdefault("dns_all", False)
    cfg.setdefault("allow_system_trust_store", True)
    return cfg

def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)
    CONFIG_FILE.chmod(0o600)

def list_profiles():
    if not PROFILES_DIR.exists():
        return []
    return sorted([p.stem for p in PROFILES_DIR.glob("*.xml")])

def normalize_profile_xml(xml_content):
    xml_content = re.sub(r'<\s*DnsServerEntry\s*>', '', xml_content)
    xml_content = re.sub(r'<\s*/\s*DnsServerEntry\s*>', '', xml_content)
    return xml_content

def parse_and_validate_profile(content, fallback="AzureVPN"):
    try:
        root_el = ET.fromstring(content)
    except ET.ParseError as e:
        raise ValueError(f"Invalid XML syntax: {e}")

    name_el = root_el.find(".//name")
    if name_el is None or not name_el.text:
        raw_name = fallback
    else:
        raw_name = name_el.text.strip()

    sanitized = re.sub(r'[^a-zA-Z0-9_\-\.]', '_', raw_name).strip('._')
    return sanitized[:64] if sanitized else fallback

def import_file(file_path, notify=True):
    p = Path(file_path)
    if not p.is_file():
        print(f"Error: File not found: {file_path}", file=sys.stderr)
        return False

    try:
        content = p.read_text(encoding="utf-8")
    except Exception as e:
        print(f"Error reading file: {e}", file=sys.stderr)
        return False

    try:
        name = parse_and_validate_profile(content, fallback=p.stem)
    except ValueError as e:
        print(f"Error: not a valid Azure VPN profile XML: {e}", file=sys.stderr)
        if notify:
            subprocess.run(["notify-send", "-a", "Azure VPN", "Import Failed", f"Invalid XML: {e}"], check=False)
        return False

    normalized = normalize_profile_xml(content)
    PROFILES_DIR.mkdir(parents=True, exist_ok=True)
    
    dest = PROFILES_DIR / f"{name}.xml"
    if dest.exists() and dest.read_text(encoding="utf-8") != normalized:
        suffix = 1
        while (PROFILES_DIR / f"{name}_{suffix}.xml").exists():
            suffix += 1
        name = f"{name}_{suffix}"
        dest = PROFILES_DIR / f"{name}.xml"

    dest.write_text(normalized, encoding="utf-8")
    dest.chmod(0o600)
    
    cfg = load_config()
    cfg["active_profile"] = name
    save_config(cfg)

    print(f"✓ Imported profile '{name}' ({dest})")
    if notify:
        subprocess.run(["notify-send", "-a", "Azure VPN", "Profile Imported", f"Imported '{name}' as active profile."], check=False)
    return True

def import_dialog():
    if not shutil.which("zenity"):
        print("Error: 'zenity' is required for the file chooser dialog.", file=sys.stderr)
        print("You can import via CLI: azurevpn import <path-to-file.xml>", file=sys.stderr)
        subprocess.run(["notify-send", "-a", "Azure VPN", "Zenity Missing", "Please run: azurevpn import <path.xml>"], check=False)
        return 1

    try:
        res = subprocess.run([
            "zenity", "--file-selection",
            "--title=Select Azure VPN Profile XML",
            "--file-filter=VPN Profiles (*.xml) | *.xml",
            "--file-filter=All Files | *"
        ], capture_output=True, text=True, timeout=120)
        
        path = res.stdout.strip()
        if path and res.returncode == 0:
            ok = import_file(path, notify=True)
            return 0 if ok else 1
    except Exception as e:
        print(f"Dialog error: {e}", file=sys.stderr)
    return 1

def get_status_data():
    ensure_dirs()
    cfg = load_config()
    profiles = list_profiles()
    active_profile = cfg.get("active_profile", "")
    if not active_profile and profiles:
        active_profile = profiles[0]
        cfg["active_profile"] = active_profile
        save_config(cfg)

    data = {}
    if shutil.which("openp2s"):
        try:
            res = subprocess.run(["openp2s", "status", "--json"], capture_output=True, text=True, timeout=5)
            if res.stdout.strip():
                data = json.loads(res.stdout)
        except (subprocess.TimeoutExpired, OSError, json.JSONDecodeError):
            data = {}

    svc_active = False
    svc_failed = False
    try:
        s_res = subprocess.run(["systemctl", "--user", "is-active", "azure-vpn"], capture_output=True, text=True, timeout=3)
        svc_active = (s_res.stdout.strip() == "active")
        f_res = subprocess.run(["systemctl", "--user", "is-failed", "azure-vpn"], capture_output=True, text=True, timeout=3)
        svc_failed = (f_res.stdout.strip() == "failed")
    except (subprocess.TimeoutExpired, OSError):
        pass

    connected = data.get("connected", False)
    if connected:
        state = "connected"
    elif svc_failed:
        state = "failed"
    elif svc_active:
        state = "connecting"
    else:
        state = "disconnected"

    return {
        "connected": connected,
        "state": state,
        "profile": data.get("profile") or active_profile,
        "active_profile": active_profile,
        "available_profiles": profiles,
        "address": data.get("address", ""),
        "interface": data.get("interface", ""),
        "gateway": data.get("gateway", ""),
        "account": data.get("account", ""),
        "uptimeSeconds": data.get("uptimeSeconds", 0),
        "dnsServers": data.get("dnsServers", [])
    }

def cmd_status(as_json=False):
    data = get_status_data()
    if as_json:
        print(json.dumps(data, indent=2))
        return

    if data["connected"]:
        print(f"Azure VPN: Connected ({data['profile']})")
        print(f"  Interface: {data['interface']}")
        print(f"  IP:        {data['address']}")
        print(f"  Account:   {data['account']}")
        print(f"  Gateway:   {data['gateway']}")
        print(f"  Uptime:    {data['uptimeSeconds']}s")
    elif data["state"] == "connecting":
        print(f"Azure VPN: Connecting to {data['active_profile']}...")
    elif data["state"] == "failed":
        print(f"Azure VPN: Failed to connect to {data['active_profile']}. Check journalctl --user -u azure-vpn")
    else:
        print(f"Azure VPN: Disconnected (Active profile: {data['active_profile'] or 'None'})")

def cmd_connect(profile_name=None):
    cfg = load_config()
    if profile_name:
        if profile_name not in list_profiles():
            if Path(profile_name).is_file():
                import_file(profile_name)
                cfg = load_config()
            else:
                print(f"Profile '{profile_name}' not found. Available: {', '.join(list_profiles())}", file=sys.stderr)
                return 1
        else:
            cfg["active_profile"] = profile_name
            save_config(cfg)

    active_profile = cfg.get("active_profile")
    if not active_profile:
        print("No active profile selected. Run 'azurevpn import <file.xml>' first.", file=sys.stderr)
        return 1

    profile_path = PROFILES_DIR / f"{active_profile}.xml"
    if not profile_path.exists():
        print(f"Profile file missing: {profile_path}", file=sys.stderr)
        return 1

    openp2s_bin = shutil.which("openp2s")
    if not openp2s_bin or not Path("/usr/local/lib/openp2s/openvpn").exists():
        print("Error: 'openp2s' or its patched openvpn binary is not installed.", file=sys.stderr)
        print("Run 'azurevpn setup' to automatically install prerequisites and configure permissions.", file=sys.stderr)
        subprocess.run(["notify-send", "-a", "Azure VPN", "Missing Dependency", "openp2s is required. Run 'azurevpn setup'."], check=False)
        return 1

    ensure_systemd_service()

    status = get_status_data()
    if status["connected"]:
        print(f"Already connected to {status['profile']} ({status['address']}).")
        return 0

    try:
        auth_res = subprocess.run([openp2s_bin, "auth", "status", str(profile_path)], capture_output=True, text=True, timeout=8)
        needs_login = auth_res.returncode != 0 or "Refresh token: cached" not in auth_res.stdout
    except Exception:
        needs_login = True

    if needs_login:
        print(f"Initiating browser authentication for {active_profile}...")
        subprocess.run(["notify-send", "-a", "Azure VPN", "Authenticating", "Please complete sign-in in your browser."], check=False)
        try:
            login_res = subprocess.run([openp2s_bin, "auth", "login", str(profile_path)], timeout=180)
            if login_res.returncode != 0:
                print("Authentication failed or cancelled.", file=sys.stderr)
                return 1
        except subprocess.TimeoutExpired:
            print("Authentication timed out.", file=sys.stderr)
            return 1

    print(f"Connecting to {active_profile}...")
    subprocess.run(["systemctl", "--user", "reset-failed", "azure-vpn"], capture_output=True, check=False)
    subprocess.run(["systemctl", "--user", "start", "azure-vpn"], check=False)

    for _ in range(24):
        time.sleep(0.5)
        st = get_status_data()
        if st["connected"]:
            print(f"✓ Connected to {active_profile} ({st['address']}) on {st['interface']}.")
            subprocess.run(["notify-send", "-a", "Azure VPN", "VPN Connected", f"Connected to {active_profile}\nIP: {st['address']}"], check=False)
            return 0
        if st["state"] == "failed":
            print(f"Error: Connection service failed. View logs with: journalctl --user -u azure-vpn -n 30", file=sys.stderr)
            subprocess.run(["notify-send", "-a", "Azure VPN", "Connection Failed", "Check journalctl --user -u azure-vpn"], check=False)
            return 1

    print("Connection started in background (check status with 'azurevpn status').")
    return 0

def cmd_setup():
    print("=== Azure VPN Plugin Setup & Hardening ===")
    
    if platform.machine() != "x86_64":
        print(f"Error: Automatic binary install only supports x86_64 (detected {platform.machine()}).", file=sys.stderr)
        print("Please build openp2s from source: https://github.com/wyruweso/openp2s", file=sys.stderr)
        return 1

    has_openp2s = bool(shutil.which("openp2s")) and Path("/usr/local/lib/openp2s/openvpn").exists()
    if has_openp2s:
        print("✓ openp2s and patched openvpn binaries found.")
    else:
        print(f"Downloading openp2s v{OPENP2S_VERSION}...")
        url = f"https://github.com/wyruweso/openp2s/releases/download/v{OPENP2S_VERSION}/openp2s-{OPENP2S_VERSION}-linux-amd64.tar.gz"
        with tempfile.TemporaryDirectory() as td:
            tmp_tar = Path(td) / "openp2s.tar.gz"
            subprocess.run(["curl", "-fsSL", "--proto", "=https", "--tlsv1.2", url, "-o", str(tmp_tar)], check=True)
            
            digest = hashlib.sha256(tmp_tar.read_bytes()).hexdigest()
            if digest != OPENP2S_SHA256:
                print(f"Error: Checksum mismatch on openp2s download!\nExpected: {OPENP2S_SHA256}\nGot:      {digest}", file=sys.stderr)
                return 1
            print("✓ Checksum verified.")
            subprocess.run(["sudo", "tar", "-xzf", str(tmp_tar), "-C", "/usr/local", "--strip-components=1"], check=True)
        print("✓ openp2s installed to /usr/local/bin/openp2s")

    # Scoped Sudoers Rule
    user = getpass.getuser()
    resolvectl_bin = shutil.which("resolvectl") or "/usr/bin/resolvectl"
    rule = f"{user} ALL=(root) NOPASSWD: /usr/local/lib/openp2s/openvpn, {resolvectl_bin}\n"
    
    print(f"Configuring scoped sudoers rule for user '{user}'...")
    with tempfile.NamedTemporaryFile("w", suffix=".sudoers", delete=False) as tf:
        tf.write(rule)
        tmp_sudoers = tf.name

    try:
        check = subprocess.run(["visudo", "-c", "-f", tmp_sudoers], capture_output=True, text=True)
        if check.returncode != 0:
            print(f"Error: generated sudoers rule failed visudo syntax validation: {check.stderr}", file=sys.stderr)
            return 1
        subprocess.run(["sudo", "install", "-m", "0440", "-o", "root", "-g", "root", tmp_sudoers, "/etc/sudoers.d/99-openp2s"], check=True)
        print("✓ Scoped sudoers rule verified and installed (/etc/sudoers.d/99-openp2s).")
    finally:
        if os.path.exists(tmp_sudoers):
            os.unlink(tmp_sudoers)

    ensure_dirs()
    ensure_systemd_service()
    print("✓ Secured configuration directory permissions (0700).")
    print("✓ Systemd background service registered.")
    print("\n✓ Setup complete! Import your profile with:")
    print("  azurevpn import <profile.xml>")
    return 0

def cmd_teardown():
    print("=== Azure VPN Plugin Teardown ===")
    subprocess.run(["systemctl", "--user", "stop", "azure-vpn"], check=False)
    subprocess.run(["systemctl", "--user", "disable", "azure-vpn"], check=False)
    
    if SERVICE_FILE.exists():
        SERVICE_FILE.unlink()
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        print("✓ Removed systemd user service.")

    sudoers_path = Path("/etc/sudoers.d/99-openp2s")
    if sudoers_path.exists():
        subprocess.run(["sudo", "rm", "-f", str(sudoers_path)], check=True)
        print("✓ Removed /etc/sudoers.d/99-openp2s.")

    print("✓ Teardown complete.")
    return 0

def cmd_disconnect():
    print("Disconnecting Azure VPN...")
    subprocess.run(["systemctl", "--user", "stop", "azure-vpn"], check=False)
    subprocess.run(["notify-send", "-a", "Azure VPN", "VPN Disconnected", "Disconnected from Azure VPN."], check=False)
    print("✓ Disconnected.")
    return 0

def cmd_daemon():
    cfg = load_config()
    active_profile = cfg.get("active_profile")
    if not active_profile:
        print("Error: No active profile configured", file=sys.stderr)
        sys.exit(1)
    profile_path = PROFILES_DIR / f"{active_profile}.xml"
    if not profile_path.exists():
        print(f"Error: Profile file not found: {profile_path}", file=sys.stderr)
        sys.exit(1)

    openp2s_bin = shutil.which("openp2s") or "/usr/local/bin/openp2s"
    args = [openp2s_bin, "connect", str(profile_path)]
    if cfg.get("allow_system_trust_store", True):
        args.append("--allow-system-trust-store")
    if cfg.get("dns_all", False):
        args.append("--dns-all")
    os.execvp(openp2s_bin, args)

def main():
    ensure_dirs()
    args = sys.argv[1:]
    if not args:
        cmd_status(as_json=False)
        return

    cmd = args[0].lower()
    if cmd in ("status", "st"):
        as_json = "--json" in args or "-j" in args
        cmd_status(as_json=as_json)
    elif cmd in ("connect", "up", "c"):
        prof = args[1] if len(args) > 1 and not args[1].startswith("-") else None
        sys.exit(cmd_connect(prof))
    elif cmd in ("disconnect", "down", "d"):
        sys.exit(cmd_disconnect())
    elif cmd in ("toggle", "t"):
        st = get_status_data()
        if st["connected"] or st["state"] == "connecting":
            sys.exit(cmd_disconnect())
        else:
            sys.exit(cmd_connect())
    elif cmd in ("list", "ls"):
        profiles = list_profiles()
        cfg = load_config()
        active = cfg.get("active_profile", "")
        if "--json" in args:
            print(json.dumps(profiles))
        else:
            print("Available profiles:")
            for p in profiles:
                mark = "*" if p == active else " "
                print(f"  {mark} {p}")
    elif cmd in ("select", "use"):
        if len(args) < 2:
            print("Usage: azurevpn select <profile_name>", file=sys.stderr)
            sys.exit(1)
        name = args[1]
        if name not in list_profiles():
            print(f"Profile '{name}' not found.", file=sys.stderr)
            sys.exit(1)
        cfg = load_config()
        cfg["active_profile"] = name
        save_config(cfg)
        print(f"Selected profile: {name}")
    elif cmd in ("import", "add"):
        if len(args) < 2:
            sys.exit(import_dialog())
        else:
            ok = import_file(args[1], notify=True)
            sys.exit(0 if ok else 1)
    elif cmd == "import-dialog":
        sys.exit(import_dialog())
    elif cmd in ("setup", "install-deps"):
        sys.exit(cmd_setup())
    elif cmd in ("teardown", "uninstall"):
        sys.exit(cmd_teardown())
    elif cmd == "daemon":
        cmd_daemon()
    else:
        print("Usage: azurevpn [connect [profile] | disconnect | status [--json] | list | select <profile> | import [file.xml] | setup | teardown]")

if __name__ == "__main__":
    main()
